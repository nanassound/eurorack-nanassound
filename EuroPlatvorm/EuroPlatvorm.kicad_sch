	(text "Strapping: IO9 10k PU (SPI boot) | IO8 10k PU | IO15 float (USB-JTAG default) | EN RC 10k + 1uF per datasheet."
		(exclude_from_sim no)
		(at 165.354 159.004 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2cb4f900-4737-46cc-8014-0274777e2c49")
	)
	(text "Doepfer 2x5: pins 1-2 = -12V (also J3 pin 3) | pins 3-8 = GND | pins 9-10 = +12V. Pin 1 = key side."
		(exclude_from_sim no)
		(at 19.812 189.484 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3dd2e867-89d1-4fb4-8945-21d7d9e4edda")
	)
	(text "J3/J4 expose all GPIOs + rails for carrier/breadboard. GPIO8/9 = strapping (10k PU) - do not hold low at reset. GPIO12/13 shared with USB."
		(exclude_from_sim no)
		(at 19.812 194.564 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4b273a73-ee18-4d81-a39d-7717b4938872")
	)
	(text "Firmware: native ESP32-C6 USB-Serial/JTAG on IO12=D- / IO13=D+ (no CH340C needed)."
		(exclude_from_sim no)
		(at 165.354 153.924 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "50edbfc1-5bd2-4b6a-80dc-d079bdb767d4")
	)
	(text "RST (EN) + BOOT (IO9) buttons for manual download mode; USB-JTAG auto-resets into download."
		(exclude_from_sim no)
		(at 165.354 156.464 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "54042ac6-8c74-4a38-8c1d-6bf6a62634a4")
	)
	(text "Power architecture:"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "76388226-a941-4bd3-b9ba-317a1b7d7e55")
	)
	(text "2) USB only (firmware): VBUS 5V -> F2 -> AMS1117-3.3 -> 3.3V"
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7fbb6cf6-9a81-4897-b666-e1373e3ac995")
	)
	(text "3) Both attached: buck (3.43V) sources the rail; AMS1117 idles (pass device off)"
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "82d61766-0d71-4f1f-ad9c-ae80187810d7")
	)
	(text "TPS54202 EN floated per TI datasheet (internal pull-up enables the converter)."
		(exclude_from_sim no)
		(at 165.354 164.084 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a7b392fc-4e63-46cc-9bd3-00b8c73642c1")
	)
	(text "Antenna: keep copper-free under module antenna area (keepout zone included in footprint)."
		(exclude_from_sim no)
		(at 165.354 161.544 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e3cfdf81-986b-4759-bc01-05fc9d21e0a8")
	)
	(text "1) Rack only: +12V -> F1 -> D1 -> TPS54202 buck -> 3.43V (R1/R2 100k/21k, Vfb 0.596V) dominates +3V3"
