(footprint "EuroPlatvorm_Daughter"
	(version 20260206)
	(generator "kicad-footprint-generator")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "EuroPlatvorm carrier stack reference for I/O daughter boards. Mating field for the two platform back-side 1x14 2.54mm headers: right bank = platform J3 (+3V3, +12V, -12V, GPIO0-7, USB_DP/DM, GND), left bank = platform J4 (GPIO23-8, GND). Row spacing 12.68mm (matches platform exactly). Platform outline (21.7x89.75mm) shown on Dwgs.User; stack back-to-back, daughter B.Cu facing platform B.Cu.")
	(tags "eurorack platvorm europlatvorm carrier daughter shield stack reference esp32-c6")
